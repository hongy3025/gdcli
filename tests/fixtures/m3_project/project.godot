; Engine configuration file.
;
; Configures gdapi M3 runtime fixture. Persistent scene has RuntimeMain
; with a ProbeTarget child that exposes `increment` and `increment_later`
; methods for runtime assertions.

config_version=5

[application]

config/name="gdcli_m3_fixture"
run/main_scene="res://scenes/runtime_main.tscn"
config/features=PackedStringArray("4.7")

[editor_plugins]

enabled=PackedStringArray("res://addons/gdapi/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"

[gdapi]

runtime_probe_hello_delay_ms=250
